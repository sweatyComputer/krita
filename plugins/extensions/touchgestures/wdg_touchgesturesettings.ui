  </author>
 <class>WdgTouchGestureSettings</class>
 <widget class="QWidget" name="WdgTouchGestureSettings">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>601</width>
    <height>460</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="lblIntro">
     <property name="text">
      <string>Three fingers on the canvas adjust brush settings instead of painting. Drag along one axis at a time; the canvas is untouched until you lift your hand.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="chkEnabled">
     <property name="text">
      <string>Enable three-finger gestures</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="boxMapping">
     <property name="title">
      <string>Mapping</string>
     </property>
     <layout class="QFormLayout" name="formMapping">
      <item column="0" row="0">
       <widget class="QLabel" name="lblVertical">
        <property name="text">
         <string>Drag up / down</string>
        </property>
       </widget>
      </item>
      <item column="1" row="0">
       <widget class="QComboBox" name="cmbVerticalAction"/>
      </item>
      <item column="1" row="1">
       <widget class="QCheckBox" name="chkInvertVertical">
        <property name="text">
         <string>Invert direction</string>
        </property>
       </widget>
      </item>
      <item column="0" row="2">
       <widget class="QLabel" name="lblHorizontal">
        <property name="text">
         <string>Drag left / right</string>
        </property>
       </widget>
      </item>
      <item column="1" row="2">
       <widget class="QComboBox" name="cmbHorizontalAction"/>
      </item>
      <item column="1" row="3">
       <widget class="QCheckBox" name="chkInvertHorizontal">
        <property name="text">
         <string>Invert direction</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="boxFeel">
     <property name="title">
      <string>Feel</string>
     </property>
     <layout class="QFormLayout" name="formFeel">
      <item column="0" row="0">
       <widget class="QLabel" name="lblSizeSensitivity">
        <property name="text">
         <string>Size sensitivity</string>
        </property>
       </widget>
      </item>
      <item column="1" row="0">
       <widget class="QDoubleSpinBox" name="spbSizeSensitivity">
        <property name="toolTip">
         <string>Brush pixels gained per pixel of finger travel.</string>
        </property>
        <property name="suffix">
         <string> px per px</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="minimum">
         <double>0.010000000000000</double>
        </property>
        <property name="maximum">
         <double>10.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.050000000000000</double>
        </property>
        <property name="value">
         <double>0.500000000000000</double>
        </property>
       </widget>
      </item>
      <item column="0" row="1">
       <widget class="QLabel" name="lblOpacitySensitivity">
        <property name="text">
         <string>Opacity sensitivity</string>
        </property>
       </widget>
      </item>
      <item column="1" row="1">
       <widget class="QDoubleSpinBox" name="spbOpacitySensitivity">
        <property name="toolTip">
         <string>Percent of the full opacity range covered by 1000 pixels of finger travel. At 2.5 a 400 pixel drag walks the whole range.</string>
        </property>
        <property name="suffix">
         <string> per 1000 px</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="minimum">
         <double>0.100000000000000</double>
        </property>
        <property name="maximum">
         <double>20.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.250000000000000</double>
        </property>
        <property name="value">
         <double>2.500000000000000</double>
        </property>
       </widget>
      </item>
      <item column="0" row="2">
       <widget class="QLabel" name="lblDeadZone">
        <property name="text">
         <string>Dead zone</string>
        </property>
       </widget>
      </item>
      <item column="1" row="2">
       <widget class="QSpinBox" name="spbDeadZone">
        <property name="toolTip">
         <string>How far three fingers must travel before Krita commits to an axis. Larger values make a three-finger tap harmless.</string>
        </property>
        <property name="suffix">
         <string> px</string>
        </property>
        <property name="minimum">
         <number>0</number>
        </property>
        <property name="maximum">
         <number>200</number>
        </property>
        <property name="value">
         <number>12</number>
        </property>
       </widget>
      </item>
      <item column="1" row="3">
       <widget class="QCheckBox" name="chkLockToAxis">
        <property name="text">
         <string>Lock to the axis the drag starts on</string>
        </property>
       </widget>
      </item>
      <item column="1" row="4">
       <widget class="QCheckBox" name="chkShowFeedback">
        <property name="text">
         <string>Also show a text message in the corner (the on-canvas brush preview already shows the value)</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>40</height>
      </size>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
